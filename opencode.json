{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "opencode": {
            "models": {
                "minimax-m2.1-free": {}
            }
        }
    },
    "model": "opencode/minimax-m2.1-free",
    "small_model": "opencode/minimax-m2.1-free",
    "default_agent": "intern",
    "agent": {
        "intern": {
            "mode": "primary",
            "model": "opencode/minimax-m2.1-free",
            "temperature": 0.7,
            "prompt": "{file:./.opencode/prompts/intern.md}",
            "permission": {
                "skill": {
                    "opencode-intern": "deny"
                }
            }
        }
    }
}
